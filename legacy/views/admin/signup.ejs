<!DOCTYPE html>
<html>
	<%- include('./includes/head.ejs') %>
	<body>
		<article id="contents_wrap" class="writing_wrap">
			<section class="contents">
				
				<div class="container">			
						
					<div class="col-sm-6 col-sm-offset-3">
					
					    <h1><span class="fa fa-sign-in"></span> 회원가입</h1>
					
					    <!-- 인증 처리 후 메시지가 있으면 메시지 표시 -->
					    <% if (message.length > 0) { %>
					        <div class="alert alert-danger"><%= message %></div>
					    <% } %>
		 
					    <form action="<%=rootpath%>/signup" method="post" >
					        <div class="form-group">
					            <label>아이디</label>
					            <input type="text" class="form-control" name="email">
					        </div>
					        <div class="form-group">
					            <label>비밀번호</label>
					            <input type="password" class="form-control" name="password">
					        </div>
					        <div class="form-group">
					            <label>글쓴이</label>
					            <input type="text" class="form-control" name="name">
					        </div>
					        <!-- <div class="form-group">
					            <label>대분류</label>
					            <input type="text" class="form-control" name="group1">
					        </div>
					        <div class="form-group">
					            <label>중분류</label>
					            <input type="text" class="form-control" name="group2">
					        </div> -->
					
					        <button type="submit" class="btn btn-warning btn-lg">회원가입</button>
					    </form>
					
					    <hr>
					
					
					</div>
					
				</div>	
			</section>
		</article>
	</body>
</html>